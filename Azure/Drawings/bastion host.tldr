								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Azure Bastion is a fully managed Azure service that provides secure RDP and SSH access to "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "virtual machines over SSL/TLS through the Azure Portal. It requires a dedicated AzureBastionSubnet"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": " and a Public IP address. VMs do not need Public IPs or inbound SSH/RDP ports exposed to the internet."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": " Bastion connects to VMs using their private IP addresses within the same VNet, improving security "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "and reducing the attack surface."
								}
							]
						}
					]
				}
			},
