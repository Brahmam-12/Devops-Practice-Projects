							"content": [
								{
									"type": "text",
									"text": "NAT Gateway is an Azure-managed service that provides secure outbound internet connectivity for resources in a subnet without requiring "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Public IP addresses on individual VMs. It offers a static outbound IP, supports multiple VMs, is highly scalable, and is the recommended "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "approach for outbound internet access in production environments."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						}
					]
