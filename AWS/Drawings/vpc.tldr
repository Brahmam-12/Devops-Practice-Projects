		{
			"x": 60,
			"y": 121.8515625,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:zfuAzi03wSwrkZxPQ2Ed6",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1425.703125,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"marks": [
										{
											"type": "bold"
										}
									],
									"text": "Amazon VPC (Virtual Private Cloud)"
								},
								{
									"type": "text",
									"text": " i"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "A VPC is a logically isolated virtual network in AWS where we deploy resources such as EC2, RDS, and Load Balancers. Within a VPC, we create subnets, "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "route tables, security groups, and gateways to control network communication. Public subnets use an Internet Gateway for internet access, "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "while private subnets typically use a NAT Gateway for outbound internet access without exposing resources directly to the internet."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "a1zYgFGl",
			"typeName": "shape"
		},
