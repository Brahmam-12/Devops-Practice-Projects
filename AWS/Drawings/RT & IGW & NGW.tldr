						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "A route table in aws it determines where network traffic should be sent. whenever a packet leaves"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "from resource like ec2 instance, aws checks the route table assosiated with that subnet and decides the "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "next hop for the traffic. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "For example when a vpc is created , AWS automatically created a main route table with a local route. "
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "This local route enables communication between subnets inside the same vpc."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "aCSF02DV",
