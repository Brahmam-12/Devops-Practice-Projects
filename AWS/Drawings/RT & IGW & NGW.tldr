		},
		{
			"x": -443.3510656672509,
			"y": 682.9340456350175,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:L1osRh5e1ZmGTMFeITdO5",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 1235.479248046875,
				"font": "draw",
				"textAlign": "start",
				"autoSize": true,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Internet gateway provides internet connectivity for a vpc. public instances use a route to the igw and usually have a public ip."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "Private instances cannot use igw directly because they do not have the public ip. Instead, they send the outbound traffic to nat gw"
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "and the nat gw uses the internet gw to access the internet while preventing unsolicated inbound connections."
								}
							]
						},
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							}
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "aMQomVUl",
			"typeName": "shape"
		},
