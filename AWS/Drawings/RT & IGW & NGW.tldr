			"meta": {},
			"id": "shape:PgoSCSfAh6gR1AjlPnREv",
			"type": "text",
			"props": {
				"color": "black",
				"size": "s",
				"w": 920,
				"font": "draw",
				"textAlign": "start",
				"autoSize": false,
				"scale": 1,
				"richText": {
					"type": "doc",
					"attrs": {
						"dir": "auto"
					},
					"content": [
						{
							"type": "paragraph",
							"attrs": {
								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "nternet Gateway is attached to a VPC and acts as the entry and exit point for Internet traffic. Public subnets have a route to the IGW and their instances can communicate directly with the Internet. Private subnets do not have a route to the IGW; instead they route Internet-bound traffic to a NAT Gateway, which then uses the IGW to access the Internet while preventing inbound Internet connections to the private instances."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
			"index": "aQUatUJO",
			"typeName": "shape"
		},
		{
			"x": 863.8126602122522,
			"y": 18.703261590437023,
			"rotation": 0,
			"isLocked": false,
			"opacity": 1,
			"meta": {},
			"id": "shape:v3SjkCy0KRQQdvFoW4xdB",
			"type": "geo",
			"props": {
				"w": 117.69552348572529,
				"h": 145.6790311836902,
				"geo": "rectangle",
				"dash": "draw",
				"growY": 0,
				"url": "",
				"scale": 1,
				"color": "black",
				"labelColor": "black",
				"fill": "none",
				"size": "s",
				"font": "draw",
				"align": "middle",
				"verticalAlign": "middle",
