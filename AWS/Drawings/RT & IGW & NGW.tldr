								"dir": "auto"
							},
							"content": [
								{
									"type": "text",
									"text": "If a VM in subnet 10.1.1.0/24 wants to communicate with another VM in subnet 10.1.2.0/24, AWS matches the destination with 10.1.0.0/16 and uses the local route, keeping the traffic inside the VPC."
								}
							]
						}
					]
				}
			},
			"parentId": "page:page",
